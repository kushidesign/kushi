;; shadow-cljs configuration
;; TODO setup :local-dev & :release aliases
{:deps
 {:aliases [:local-dev]}

 :dev-http
 {5001 "public"}

 :builds
 {:app
  {:devtools         {:log             false
                      :reload-strategy :full
                      :watch-dir       "public"}
   :target           :browser
   :compiler-options {:output-feature-set :es8
                      :warnings           {:redef false}}
   :modules          {:main {:init-fn site.browser/init}}
   :output-dir       "public/js"
   :build-hooks      [(kushi.css.build.analyze/hook)
                      (shadow.cljs.build-report/hook
                       {:output-to "tmp/report.html"})]
   :release          {:build-options {:ns-aliases {kushi.ui.core  kushi.ui.stubs.core
                                                   bling.core     bling.stubs.core
                                                   bling.explain  bling.stubs.explain
                                                   bling.hifi     bling.stubs.hifi
                                                   fireworks.core fireworks.stubs.core
                                                   fireworks.pp   fireworks.stubs.pp
                                                   }}}}}}
